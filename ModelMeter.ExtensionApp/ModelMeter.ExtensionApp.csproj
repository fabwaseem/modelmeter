<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ModelMeter.ExtensionApp</RootNamespace>
    <AssemblyName>ModelMeter.ExtensionApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <WidBarPluginId>com.fabwaseem.modelmeter</WidBarPluginId>
    <WidBarPluginName>ModelMeter</WidBarPluginName>
    <WidBarPluginDescription>Your AI usage. One dashboard.</WidBarPluginDescription>
    <WidBarPluginCategory>Developer Tools</WidBarPluginCategory>
    <WidBarPluginVersion>0.1.0</WidBarPluginVersion>
    <WidBarPluginPreviewWidth>190</WidBarPluginPreviewWidth>
    <WidBarPluginConfigurable>true</WidBarPluginConfigurable>
  </PropertyGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="WidBar.SDK" Version="2.3.5" />
  </ItemGroup>
</Project>
